# ==============================================================================
# Web & Shared Configuration (loaded by Next.js and CLIs via src/lib/env.ts)
# ==============================================================================

# SQLite database path (relative or absolute)
DATABASE_PATH=./data/medium-reader.db

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ==============================================================================
# Ingest & CLI Configuration Only (used by src/cli/* and src/ingest/* via src/lib/ingest-env.ts)
# The web reader application does not load or require these variables.
# ==============================================================================

# Freedium Base URLs (comma separated)
FREEDIUM_BASE_URLS=https://freedium-mirror.cfd,https://freedium.cfd

# Gmail IMAP Credentials
# To generate an app password, go to Google Account -> Security -> 2-Step Verification -> App passwords.
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Politeness toward Freedium/Medium to avoid rate limits
ARTICLE_FETCH_DELAY_MS=1500
ARTICLE_FETCH_CONCURRENCY=3

# Bounding how far back each IMAP search looks (processedEmails handles idempotency)
INGEST_LOOKBACK_DAYS=14

# ---
# CLI Commands
# ---
# pnpm fetch-digests      : Connects to Gmail, fetches new digests, and upserts articles.
# pnpm purge-old-articles : Deletes unsaved articles older than 90 days (use --dry-run to test).
# pnpm inspect-db         : Prints total counts and recent additions to the DB.


